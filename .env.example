# Copie este arquivo para ".env" e preencha os valores reais (uso local/Railway).
# NUNCA suba o arquivo ".env" de verdade para o GitHub.

# ---------- Usadas pelo server.js (Railway / local) ----------

# Chave da API da Groq (usada primeiro, se preenchida — texto gerado por Llama).
# Pegue a sua em https://console.groq.com
GROQ_API_KEY=

# Chave da API da Anthropic (usada se a Groq não estiver configurada ou falhar).
# Se ambas ficarem em branco, o sistema usa um texto padrão automático (fallback).
ANTHROPIC_API_KEY=

# Porta em que o servidor vai rodar. O Railway define isso automaticamente
# em produção (você pode deixar 8080 mesmo assim, é só o padrão local).
PORT=8080

# ---------- NÃO usadas pelo server.js — só pelo script do GitHub Actions ----------
# Estas NÃO devem ir no .env do Railway. Configure-as como "Secrets" no
# repositório do GitHub (Settings > Secrets and variables > Actions):
#
#   FIREBASE_SERVICE_ACCOUNT   -> JSON completo da service account do Firebase
#                                 (Firebase Console > Configurações do projeto >
#                                 Contas de serviço > Gerar nova chave privada)
#   OWNER_UID                  -> o UID do seu usuário logado (aparece na aba
#                                 "Perfil de Afiliado" do painel depois do login)
#   GROQ_API_KEY / ANTHROPIC_API_KEY -> opcionais, mesmas chaves acima, se quiser
#                                 que o bot automático também gere a copy de venda
#   MIN_DESCONTO_PCT           -> desconto mínimo (%) pra uma oferta ser aprovada (padrão 25)
#   MIN_COMISSAO_PCT           -> comissão mínima (%) pra uma oferta ser aprovada (padrão 7)

# ---------- Instagram / Meta (backend) ----------
# Configure somente no servidor (Railway/Render/etc). NUNCA no index.html
# nem em nenhum arquivo do frontend.
META_GRAPH_VERSION=v26.0
META_GRAPH_HOST=https://graph.instagram.com
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=

# App Secret do app "BOT OFERTAS" no Meta Developers (Configurações do
# app > Básico > Chave secreta do app). Usado SÓ pra validar a assinatura
# do webhook (X-Hub-Signature-256) — nunca é enviado em nenhuma chamada.
META_APP_SECRET=

# Token que VOCÊ inventa (uma string aleatória qualquer) e cola nos dois
# lugares: aqui E no campo "Verificar token" quando configurar o Webhook
# no Meta Developers. Serve só pra confirmar que é você configurando, não
# tem relação com nenhuma chave da Meta.
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=

# Trava de segurança: com "true" (padrão), o bot NUNCA manda DM de
# verdade — só registra no log o que teria mandado. Só mude pra "false"
# depois de testar bastante em DRY_RUN.
INSTAGRAM_DRY_RUN=true

# Domínios que podem chamar a API do backend (separados por vírgula).
# Ex: https://vina-13dev.github.io
# Sem essa variável, o CORS fica aberto geral — ok pra testar local, não
# recomendado em produção.
ALLOWED_ORIGINS=

# Bucket do Firebase Storage (usado pra gerar uma URL temporária da arte
# antes de publicar). Veja em Firebase Console > Storage.
FIREBASE_STORAGE_BUCKET=

# JSON completo da service account do Firebase (Firebase Console >
# Configurações do projeto > Contas de serviço > Gerar nova chave
# privada). O backend usa essa mesma credencial pra tudo (Firestore,
# Auth, Storage).
FIREBASE_SERVICE_ACCOUNT=
