# Use o ID/Secret que aparecem em:
# Meta > Casos de uso > Gerenciar mensagens e conteúdo no Instagram
# > Configuração da API com login do Instagram
# ATENÇÃO: é o "ID do app do Instagram", não o ID principal do app Meta.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Precisa ser exatamente a URL cadastrada na Meta.
# Ex.: https://SEU-BACKEND.com/api/instagram/oauth/callback
INSTAGRAM_OAUTH_REDIRECT_URI=

# Página do seu painel para onde voltar depois de conectar.
# Ex.: https://SEU-USUARIO.github.io/BOT-SHOPEE/?instagram=connected
INSTAGRAM_OAUTH_SUCCESS_URL=
INSTAGRAM_OAUTH_ERROR_URL=

# Gere duas strings aleatórias grandes e diferentes.
INSTAGRAM_OAUTH_STATE_SECRET=
INSTAGRAM_TOKEN_ENCRYPTION_KEY=

# Permissões. Para Comment-to-DM, as 3 primeiras são essenciais.
# content_publish mantém compatibilidade com a função atual de publicar imagem.
INSTAGRAM_OAUTH_SCOPES=instagram_business_basic,instagram_business_manage_comments,instagram_business_manage_messages,instagram_business_content_publish

META_GRAPH_HOST=https://graph.instagram.com
META_GRAPH_VERSION=v26.0

# Fallback antigo (pode deixar vazio depois que OAuth estiver funcionando):
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=

# Para o Comment-to-DM real, depois dos testes:
INSTAGRAM_DRY_RUN=true
